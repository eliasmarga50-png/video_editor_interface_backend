# ==============================================================================
# CineAI Backend Environment Configuration
# Example file with variable names only (no secrets included).
# configure the providers you wish to use.
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=
PORT=
HOST=
PUBLIC_BASE_URL=
CORS_ORIGIN=
LOG_LEVEL=

# Authentication Secret (Used to sign and verify JSON Web Tokens)
JWT_ACCESS_SECRET=

# ------------------------------------------------------------------------------
# LLM Providers Configuration
# Active provider: 'gemini' | 'groq' | 'ollama' | 'anthropic' | 'openai' | 'development'
# 'development' runs a built-in heuristic planner without requiring any API keys.
# ------------------------------------------------------------------------------
LLM_PROVIDER=

# Google Gemini (Recommended Free Tier - 15 RPM / 1M TPM free at https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=

# Groq Cloud (Free Tier - ultra-fast Llama 3 models at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=

# Ollama (Local & Free - runs models locally on your machine at http://localhost:11434)
OLLAMA_BASE_URL=

# OpenAI (Commercial credits required at https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
WHISPER_MODEL=

# Anthropic (Commercial credits required at https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ------------------------------------------------------------------------------
# Video & Media Generation Providers Configuration
# Active provider: 'pollinations' | 'pexels' | 'runway' | 'luma' | 'local'
# - 'pollinations': Generates AI media directly with zero API key needed.
# - 'pexels': Real HD stock footage via free API key (200 req/hr at https://www.pexels.com/api).
# - 'local': Built-in project media synthesizer running offline.
# - 'runway' / 'luma': Commercial neural video generation.
# ------------------------------------------------------------------------------
VIDEO_PROVIDER=

# Pexels Video API (Free 200 requests/hour at https://www.pexels.com/api)
PEXELS_API_KEY=

# Runway ML (Commercial credits required at https://runwayml.com)
RUNWAYML_API_KEY=
RUNWAY_MODEL=
RUNWAY_VERSION=

# Luma Dream Machine (Commercial credits required at https://lumalabs.ai)
LUMA_API_KEY=
LUMA_MODEL=

# Video Task Cache & Rate Limits
VIDEO_TASK_TTL_MS=
MAX_UPLOAD_MB=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
